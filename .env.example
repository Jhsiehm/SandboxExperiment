# Copy to .env. None of these are required for the fixture smoke path.
FRED_API_KEY=
CONGRESS_API_KEY=
# Free key for `psbx elections sync-census --execute`; never written to cache metadata.
CENSUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
# Paid traffic is OFF even when keys are present. Enable only for an intentional run.
PSBX_ENABLE_PAID_MODELS=0
# Local fail-closed ceilings. Estimates reserve the full configured output allowance.
PSBX_MAX_RUN_USD=1.00
PSBX_MAX_REQUEST_USD=0.10
PSBX_MAX_PAID_REQUESTS=100
PSBX_MAX_INPUT_TOKENS=16000
# Keep paid credentials pinned to official provider origins. Leave this disabled.
PSBX_ALLOW_CUSTOM_PROVIDER_BASE_URL=0
# Client-side OpenRouter limiter (defaults match code if unset).
# Do not lower these: a 12-agent swarm serializes at 2s/req on purpose.
OPENROUTER_MIN_INTERVAL_SEC=2.0
OPENROUTER_MAX_PER_MINUTE=20
OPENROUTER_MAX_CONCURRENCY=1
OPENROUTER_MAX_TOKENS=256
# Local Llama 3.1 8B / Qwen2.5 7B (config/models.yaml) need this endpoint.
# They never fall back to OPENROUTER_API_KEY.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local

# AgentSociety 2 (optional: pip install -e "../AgentSociety/packages/agentsociety2")
# Sibling clone: gh repo clone tsinghua-fib-lab/AgentSociety (next to this repo).
# Point at OpenRouter later with AGENTSOCIETY_LLM_API_BASE=https://openrouter.ai/api/v1
# and AGENTSOCIETY_LLM_MODEL=openai/gpt-4.1-mini — do not copy keys around.
AGENTSOCIETY_LLM_API_KEY=
AGENTSOCIETY_LLM_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_LLM_MODEL=gpt-4.1-mini
WORKSPACE_PATH=.
PSBX_AGENTSOCIETY_ROOT=

# Internet Archive (only for `psbx corpus build --live`). Identify the crawl.
# https://archive.org/developers/bots.html
PSBX_IA_USER_AGENT_SUFFIX=
