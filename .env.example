# Copy to .env. None of these are required for the fixture smoke path.
FRED_API_KEY=
CONGRESS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local

# AgentSociety 2 (optional: pip install -e ".[society]")
AGENTSOCIETY_LLM_API_KEY=
AGENTSOCIETY_LLM_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_LLM_MODEL=gpt-4.1-mini
WORKSPACE_PATH=.

# Internet Archive (only for `psbx corpus build --live`). Identify the crawl.
# https://archive.org/developers/bots.html
PSBX_IA_USER_AGENT_SUFFIX=
